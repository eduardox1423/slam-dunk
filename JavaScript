// Renderizar Cards dos Jogadores
const container = document.getElementById("players-container");
const filterBtns = document.querySelectorAll(".filter-btn");

function renderPlayers(filter = "todos") {
    container.innerHTML = "";
    const filtered = filter === "todos" ? players : players.filter(p => p.category === filter);

    filtered.forEach(player => {
        const card = document.createElement("div");
        card.className = "player-card";
        card.innerHTML = `
            <div class="player-header">
                <h3>${player.name}</h3>
                <span class="jersey-number">${player.number}</span>
            </div>
            <p class="player-pos">${player.position} • ${player.height}</p>
            <p style="margin-bottom: 15px; font-size: 0.95rem;">${player.desc}</p>
            ${Object.entries(player.stats).map(([key, val]) => `
                <div class="stat-bar">
                    <span>${key}: ${val}%</span>
                    <div class="bar-bg"><div class="bar-fill" style="width: ${val}%"></div></div>
                </div>
            `).join("")}
        `;
        container.appendChild(card);
    });
}

filterBtns.forEach(btn => {
    btn.addEventListener("click", () => {
        filterBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        renderPlayers(btn.dataset.filter);
    });
});

renderPlayers();

