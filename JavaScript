// Mini-Game de Lance Livre (Canvas)
const canvas = document.getElementById("basketballCanvas");
const ctx = canvas.getContext("2d");
const shootBtn = document.getElementById("shoot-btn");
const powerBar = document.getElementById("power-bar");
const feedback = document.getElementById("game-feedback");
const scoreEl = document.getElementById("score");
const highScoreEl = document.getElementById("high-score");

let power = 0;
let charging = false;
let chargeInterval;
let score = 0;
let highScore = 0;

let ball = { x: 80, y: 220, radius: 15, shooting: false, vx: 0, vy: 0, scored: false };
const hoop = { x: 320, y: 120, width: 45 };

function drawCourt() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Tabela
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(360, 70, 8, 70);

    // Aro
    ctx.strokeStyle = "#ff4500";
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(hoop.x, hoop.y);
    ctx.lineTo(hoop.x + hoop.width, hoop.y);
    ctx.stroke();

    // Rede simples
    ctx.strokeStyle = "#cccccc";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(hoop.x + 5, hoop.y);
    ctx.lineTo(hoop.x + 12, hoop.y + 30);
    ctx.lineTo(hoop.x + 33, hoop.y + 30);
    ctx.lineTo(hoop.x + 40, hoop.y);
    ctx.stroke();

    // Bola
    ctx.fillStyle = "#e65c00";
    ctx.beginPath();
    ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = "#000";
    ctx.lineWidth = 1.5;
    ctx.stroke();
}

function updateGame() {
    if (ball.shooting) {
        ball.x += ball.vx;
        ball.y += ball.vy;
        ball.vy += 0.35; // Gravidade

        // Checar se entrou no aro
        if (!ball.scored && ball.vy > 0 &&
            ball.x > hoop.x && ball.x < hoop.x + hoop.width &&
            Math.abs(ball.y - hoop.y) < 12) {
            ball.scored = true;
            score++;
            if (score > highScore) highScore = score;
            scoreEl.textContent = score;
            highScoreEl.textContent = highScore;
            feedback.textContent = "SWISH! Cesta perfeita do Shohoku!";
            feedback.style.color = "#28a745";
        }

        // Resetar bola quando sair da tela
        if (ball.y > canvas.height + 20 || ball.x > canvas.width + 20) {
            if (!ball.scored) {
                score = 0;
                scoreEl.textContent = score;
                feedback.textContent = "Acertou o aro! Tente novamente.";
                feedback.style.color = "#ff4d4d";
            }
            resetBall();
        }
    }
    drawCourt();
    requestAnimationFrame(updateGame);
}

function resetBall() {
    ball = { x: 80, y: 220, radius: 15, shooting: false, vx: 0, vy: 0, scored: false };
    power = 0;
    powerBar.style.width = "0%";
}

function startCharge() {
    if (ball.shooting) return;
    charging = true;
    power = 0;
    feedback.textContent = "";
    chargeInterval = setInterval(() => {
        power += 2.5;
        if (power > 100) power = 0;
        powerBar.style.width = power + "%";
    }, 25);
}

function releaseShot() {
    if (!charging) return;
    charging = false;
    clearInterval(chargeInterval);

    ball.shooting = true;
    // Zona verde fica entre 65% e 85%
    if (power >= 65 && power <= 85) {
        ball.vx = 5.4;
        ball.vy = -10.2;
    } else if (power < 65) {
        ball.vx = 4.2;
        ball.vy = -8.5;
    } else {
        ball.vx = 6.5;
        ball.vy = -11.5;
    }
}

shootBtn.addEventListener("mousedown", startCharge);
shootBtn.addEventListener("mouseup", releaseShot);
shootBtn.addEventListener("touchstart", (e) => { e.preventDefault(); startCharge(); });
shootBtn.addEventListener("touchend", (e) => { e.preventDefault(); releaseShot(); });

updateGame();
