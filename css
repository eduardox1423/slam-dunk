:root {
    --red: #d91c24;
    --dark-red: #9e1117;
    --black: #121212;
    --dark-gray: #1e1e1e;
    --white: #ffffff;
    --light-gray: #f4f4f4;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Roboto', sans-serif;
}

html {
    scroll-behavior: smooth;
}

h1, h2, h3, .logo {
    font-family: 'Anton', sans-serif;
    letter-spacing: 1px;
}

/* Navbar */
.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: var(--black);
    color: var(--white);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 5%;
    z-index: 1000;
    border-bottom: 3px solid var(--red);
}

.logo {
    font-size: 1.8rem;
}

.logo span {
    color: var(--red);
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
}

.nav-links a {
    color: var(--white);
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--red);
}

/* Hero */
.hero {
    height: 90vh;
    background: linear-gradient(rgba(18, 18, 18, 0.8), rgba(158, 17, 23, 0.85)),
                url('https://images.unsplash.com/photo-1546519638-68e109498ffc?auto=format&fit=crop&w=1600&q=80') center/cover;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--white);
    padding: 0 20px;
    margin-top: 60px;
}

.badge {
    background-color: var(--red);
    padding: 5px 12px;
    font-size: 0.85rem;
    font-weight: bold;
    border-radius: 4px;
}

.hero h1 {
    font-size: 3.5rem;
    margin: 15px 0;
}

.hero p {
    max-width: 600px;
    margin: 0 auto 25px;
    font-size: 1.1rem;
    line-height: 1.6;
}

/* Botões */
.btn-primary, .btn-secondary {
    display: inline-block;
    padding: 12px 28px;
    font-weight: bold;
    text-decoration: none;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
    transition: transform 0.2s, background 0.3s;
}

.btn-primary {
    background-color: var(--red);
    color: var(--white);
}

.btn-primary:hover {
    background-color: var(--dark-red);
    transform: scale(1.05);
}

.btn-secondary {
    background-color: var(--black);
    color: var(--white);
}

.btn-secondary:hover {
    background-color: var(--red);
}

/* Seções */
.section {
    padding: 80px 5%;
}

.bg-dark {
    background-color: var(--black);
}

.container {
    max-width: 1100px;
    margin: 0 auto;
}

.section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 40px;
    color: var(--black);
}

.text-white {
    color: var(--white);
}

/* Sobre */
.about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    align-items: center;
}

.about-text p {
    margin-bottom: 15px;
    line-height: 1.7;
    font-size: 1.05rem;
}

.about-stats {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.stat-box {
    background-color: var(--light-gray);
    border-left: 5px solid var(--red);
    padding: 15px 20px;
}

.stat-box h3 {
    font-size: 2rem;
    color: var(--red);
}

/* Jogadores */
.filter-buttons {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 8px 18px;
    border: 2px solid var(--red);
    background: transparent;
    color: var(--white);
    cursor: pointer;
    font-weight: bold;
    border-radius: 20px;
    transition: 0.3s;
}

.filter-btn.active, .filter-btn:hover {
    background: var(--red);
}

.players-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.player-card {
    background-color: var(--dark-gray);
    color: var(--white);
    border-radius: 8px;
    padding: 25px;
    border-top: 5px solid var(--red);
    transition: transform 0.3s;
}

.player-card:hover {
    transform: translateY(-5px);
}

.player-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.jersey-number {
    font-family: 'Anton', sans-serif;
    font-size: 2.2rem;
    color: var(--red);
}

.player-pos {
    font-size: 0.85rem;
    color: #bbb;
    margin-bottom: 15px;
}

.stat-bar {
    margin: 8px 0;
    font-size: 0.85rem;
}

.bar-bg {
    background: #333;
    height: 8px;
    border-radius: 4px;
    margin-top: 4px;
}

.bar-fill {
    background: var(--red);
    height: 100%;
    border-radius: 4px;
}

/* Citações */
.quote-container {
    text-align: center;
    max-width: 750px;
}

.quote-box {
    background-color: var(--light-gray);
    padding: 35px;
    border-radius: 8px;
    border-left: 6px solid var(--red);
    margin-bottom: 20px;
}

#quote-text {
    font-size: 1.4rem;
    font-style: italic;
    margin-bottom: 10px;
}

#quote-author {
    font-weight: bold;
    color: var(--red);
}

/* Mini-game */
.game-container {
    text-align: center;
}

.scoreboard {
    display: flex;
    justify-content: center;
    gap: 30px;
    color: var(--white);
    font-size: 1.2rem;
    font-weight: bold;
    margin: 20px 0;
}

canvas {
    background-color: #2b2b2b;
    border: 3px solid var(--red);
    border-radius: 8px;
    max-width: 100%;
}

.power-bar-container {
    width: 300px;
    height: 25px;
    background: #444;
    margin: 20px auto;
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    border: 2px solid var(--white);
}

.target-zone {
    position: absolute;
    left: 65%;
    width: 20%;
    height: 100%;
    background-color: #28a745;
}

#power-bar {
    width: 0%;
    height: 100%;
    background-color: var(--red);
    opacity: 0.85;
}

.feedback-text {
    color: var(--white);
    margin-top: 15px;
    font-weight: bold;
    min-height: 24px;
}

/* Footer */
footer {
    background-color: #0a0a0a;
    color: #888;
    text-align: center;
    padding: 20px;
    font-size: 0.9rem;
}

@media (max-width: 768px) {
    .hero h1 { font-size: 2.3rem; }
    .about-grid { grid-template-columns: 1fr; }
    .nav-links { display: none; }
}
